# docker-compose.yml의 포트 매핑(127.0.0.1:4001:4001)과 맞춰 둔 값
PORT=4001

# Cloudflare R2 — 이 서버 전용 버킷, 해당 버킷으로만 범위를 좁힌 API 토큰
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://example.r2.dev

# Image Setting
MAX_UPLOAD_BYTES=10485760
GC_SWEEP_INTERVAL_MS=3600000
GC_PENDING_TTL_HOURS=24

# 등록된 프로젝트 목록의 단일 소스 — "slug:apiKey[:rateLimit]"를 콤마로 구분, 서버 시작 시 DB에 반영됨
# 목록에서 뺀 프로젝트는 비활성화되어 키가 더 이상 통하지 않음. 비어 있으면 서버가 시작되지 않음
# apiKey는 길고 랜덤한 값으로 (예: openssl rand -hex 32)
PROJECTS=test:replace-with-a-long-random-key

# 로컬 개발 시 SQLite 파일 위치 (docker-compose.yml에서는 /app/data/image_server.sqlite로 덮어씀)
DATABASE_PATH=./data/image_server.sqlite
